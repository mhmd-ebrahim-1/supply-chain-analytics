relationship rel_fact_product
	fromColumn: fact_order_items.product_id
	toColumn: dim_product.product_id

relationship rel_fact_customer
	fromColumn: fact_order_items.customer_id
	toColumn: dim_customer.customer_id

relationship rel_fact_geography
	fromColumn: fact_order_items.geography_id
	toColumn: dim_geography.geography_id

relationship rel_fact_order
	fromColumn: fact_order_items.order_id
	toColumn: dim_order.order_id

relationship rel_fact_order_date
	fromColumn: fact_order_items.order_date_key
	toColumn: dim_date.date_key

relationship rel_fact_shipping_date
	isActive: false
	fromColumn: fact_order_items.shipping_date_key
	toColumn: dim_date.date_key
