table _Measures
	lineageTag: 01006c2a-fc83-4495-b1f8-cf5e282bc97d

	measure 'Total Sales' =
			SUM ( fact_order_items[sales] )
		formatString: $#,##0.00
		displayFolder: 1. Financial KPIs
		lineageTag: 56e7c14c-0c5a-4aad-a9da-740f3d0dddc2

	measure 'Total Profit' =
			SUM ( fact_order_items[benefit_per_order] )
		formatString: $#,##0.00
		displayFolder: 1. Financial KPIs
		lineageTag: 5c2f119e-4d8d-479c-9b25-25bfb3a40542

	measure 'Profit Margin %' =
			DIVIDE ( [Total Profit], [Total Sales], 0 )
		formatString: 0.0%
		displayFolder: 1. Financial KPIs
		lineageTag: a336f95c-06c3-4ce5-98e2-c0a11471f9dd

	measure 'Total Orders' =
			DISTINCTCOUNT ( fact_order_items[order_id] )
		formatString: #,##0
		displayFolder: 2. Volume KPIs
		lineageTag: 50fe7fb4-6a2e-4d89-af61-21101ec976be

	measure 'Total Quantity' =
			SUM ( fact_order_items[order_item_quantity] )
		formatString: #,##0
		displayFolder: 2. Volume KPIs
		lineageTag: f769a02d-9324-4dc7-9c18-54be78fd659e

	measure 'AOV' =
			DIVIDE ( [Total Sales], [Total Orders], 0 )
		formatString: $#,##0.00
		displayFolder: 1. Financial KPIs
		lineageTag: 4d35fb0b-3a87-4607-870d-97886d8d1c53

	measure 'Total Discount' =
			SUM ( fact_order_items[order_item_discount] )
		formatString: $#,##0.00
		displayFolder: 1. Financial KPIs
		lineageTag: 9480a0f7-dcf3-4312-a807-5c6a1b0fe699

	measure 'Avg Discount Rate %' =
			AVERAGE ( fact_order_items[order_item_discount_rate] )
		formatString: 0.0%
		displayFolder: 1. Financial KPIs
		lineageTag: fb4062b9-cd1f-4ae4-9f03-784241f5ecc8

	measure 'Avg Real Shipping Days' =
			AVERAGE ( fact_order_items[days_for_shipping_real] )
		formatString: 0.00
		displayFolder: 3. Delivery KPIs
		lineageTag: 0d1c7bb1-2ebb-4505-9fd5-5503bb789b78

	measure 'Avg Scheduled Shipping Days' =
			AVERAGE ( fact_order_items[days_for_shipment_scheduled] )
		formatString: 0.00
		displayFolder: 3. Delivery KPIs
		lineageTag: a8c07c63-ce2d-4543-80c8-47b094774974

	measure 'Shipping Delay Variance' =
			[Avg Real Shipping Days] - [Avg Scheduled Shipping Days]
		formatString: +0.00;-0.00;0.00
		displayFolder: 3. Delivery KPIs
		lineageTag: 9ffd0893-9ff7-4e0d-9d23-249509bd97fe

	measure 'Late Delivery Orders' =
			CALCULATE ( [Total Orders], fact_order_items[late_delivery_risk] = 1 )
		formatString: #,##0
		displayFolder: 3. Delivery KPIs
		lineageTag: 8d0f0251-3546-4a4e-a0b5-b0e4ea66c5d0

	measure 'Late Delivery Rate %' =
			DIVIDE ( [Late Delivery Orders], [Total Orders], 0 )
		formatString: 0.0%
		displayFolder: 3. Delivery KPIs
		lineageTag: e7cc8012-dfcf-4213-8b55-c976a9cfe2e1

	measure 'On-Time Delivery Rate %' =
			DIVIDE (
			    CALCULATE ( [Total Orders], dim_shipping[delivery_status] IN { "Shipping on time", "Advance shipping" } ),
			    [Total Orders],
			    0
			)
		formatString: 0.0%
		displayFolder: 3. Delivery KPIs
		lineageTag: e6d13d8c-5951-49ee-a305-77f88993cb67

	measure 'Active Customers' =
			DISTINCTCOUNT ( fact_order_items[customer_id] )
		formatString: #,##0
		displayFolder: 4. Customer KPIs
		lineageTag: 54f5aad5-51ec-469c-99f7-015ec92ff606

	measure 'Active Products' =
			DISTINCTCOUNT ( fact_order_items[product_id] )
		formatString: #,##0
		displayFolder: 5. Product KPIs
		lineageTag: 27c9638a-760e-4b9a-855a-3e39973dbc51

	measure 'Suspected Fraud Orders' =
			CALCULATE ( [Total Orders], dim_order[order_status] = "SUSPECTED_FRAUD" )
		formatString: #,##0
		displayFolder: 4. Customer KPIs
		lineageTag: 172c52fc-79e7-4758-ba68-9176c7607f2c

	measure 'Sales per Customer' =
			DIVIDE ( [Total Sales], [Active Customers], 0 )
		formatString: $#,##0.00
		displayFolder: 4. Customer KPIs
		lineageTag: 37b08917-f39f-499c-aa46-cd97328d43d3

	measure 'Countries Reached' =
			DISTINCTCOUNT ( dim_geography[order_country] )
		formatString: #,##0
		displayFolder: 4. Customer KPIs
		lineageTag: b82a38ac-2f9c-48dc-b740-68d472ea2151

	column Dummy
		dataType: int64
		isHidden
		lineageTag: d12a6a6b-0032-4b5a-b21f-ccd1bbd762d0
		summarizeBy: none
		sourceColumn: Dummy

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i45WMlSKjQUA", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Dummy = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Dummy", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
